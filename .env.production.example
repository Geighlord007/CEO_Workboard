# ============================================================
# 生产环境配置（CloudBase 云开发部署）——复制本文件为 .env.production 后填写
#   cp .env.production.example .env.production
# .env.production 已被 .gitignore 忽略，不会进 git 仓库
# 完整步骤见 部署指南-CloudBase.md
# ============================================================

# ==============================
# 邮箱 + 密码登录（国内主推，脱离 Google）
# ==============================
# 第一个管理员邮箱（首次用它 + 下面的初始密码登录，之后用你自己设的密码）
ADMIN_EMAIL=you@example.com
# 管理员初始密码：仅首次登录用，登录一次后即被你自己设的密码取代
ADMIN_INITIAL_PASSWORD=please-change-me

# 允许登录的邮箱白名单，逗号分隔（第一个会成为管理员）
ALLOWED_EMAILS=you@example.com,boss@example.com

# 会话签名密钥：运行 `openssl rand -hex 32` 生成一个
APP_SECRET=

# 云开发 MySQL 直连地址（部署指南第 2 步「开启直连服务」后复制）
#   - 本地跑迁移时用「外网地址」
#   - 部署到云托管后改用「内网地址」（需在云托管开私有网络）
# 格式：mysql://用户名:密码@地址:3306/数据库名（无需 ssl 参数）
DATABASE_URL=mysql://root:你的密码@your-host.mysql.tencentcdb.com:3306/tcb

# ==============================
# Google 登录（可选；不配置则纯用邮箱密码登录，推荐保持留空）
# ==============================
GOOGLE_CLIENT_ID=

# ==============================
# AI 指令助手（可选，OpenAI 兼容；不配置则该功能提示后不可用）
# ==============================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxx
LLM_MODEL=deepseek-chat