# WTC Nginx 反代示例（HTTPS 必需，手机访问建议）
# 用法：复制为 /etc/nginx/conf.d/wtc.conf，替换 wtc.example.com；再用 certbot 签发证书。

server {
    listen 80;
    server_name wtc.example.com;
    # certbot 会自动加 443 段；也可手动加 TLS
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name wtc.example.com;

    ssl_certificate     /etc/letsencrypt/live/wtc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wtc.example.com/privkey.pem;

    client_max_body_size 60m;   # 与后端 bodyLimit(50MB) 对齐留余量

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";   # 支持 HMR/SSE（开发）；生产无害
    }
}
